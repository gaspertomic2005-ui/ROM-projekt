Cell[CellGroupData[{

Cell["3. Lastne funkcije za pridobivanje in \[CHacek]i\[SHacek]\[CHacek]enje \
podatkov", "Section",ExpressionUUID->"4c143924-84a1-7a44-8c7d-08040e154a3d"],

Cell["\<\
Za naprednej\[SHacek]i del projekta definiramo ve\[CHacek] lastnih funkcij z \
Module. Funkcija getTemperatureData pridobi mese\[CHacek]ne povpre\[CHacek]ne \
temperature, cleanSeries pretvori koli\[CHacek]ine v \[ZHacek]elene enote in \
odstrani neveljavne vrednosti, annualMean pa iz mese\[CHacek]nih podatkov \
izra\[CHacek]una letna povpre\[CHacek]ja.\
\>", "Text",ExpressionUUID->"f7a45017-14b7-a44d-83a4-b11621dc3b21"],

Cell["\<\
ClearAll[cleanSeries, getTemperatureData, getPrecipitationData, yearOf, \
annualMean, annualSum];

cleanSeries[data_, unit_] := Module[{pairs},
  pairs = Normal[data];
  Map[
    {#[[1]], N[QuantityMagnitude[UnitConvert[#[[2]], unit]]]} &,
    pairs
  ]
];
getTemperatureData[coords_] := Module[{raw},
  raw = WeatherData[
    coords,
    \"MeanTemperature\",
    {startDate, endDate, \"Month\"}
  ];
  cleanSeries[raw, \"DegreesCelsius\"]
];

getPrecipitationData[coords_, from_, to_] := Module[{raw, pairs},
  raw = WeatherData[
    coords,
    \"TotalPrecipitation\",
    {from, to, \"Month\"}
  ];

  pairs = Normal[raw];

  Map[
    {#[[1]], N[10 #[[2]]]} &,
    pairs
  ]
];

yearOf[d_] := DateValue[DateObject[d], \"Year\"];

annualMean[data_] := Module[{grouped},
  grouped = GroupBy[
    data,
    yearOf[First[#]] & -> Last
  ];

  SortBy[
    KeyValueMap[
      {#1, Mean[#2]} &,
      grouped
    ],
    First
  ]
];

annualSum[data_] := Module[{grouped},
  grouped = GroupBy[
    data,
    yearOf[First[#]] & -> Last
  ];

  SortBy[
    KeyValueMap[
      {#1, Total[#2]} &,
      grouped
    ],
    First
  ]
];\
\>", "Input",
 CellChangeTimes->{
  3.997002268552126*^9, 3.997002397459633*^9, 3.997002460081972*^9, 
   3.9970025482635536`*^9, {3.9970026867865353`*^9, 3.99700269437809*^9}, 
   3.997002958777426*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"2f6a4b93-4491-e048-93b4-c6667af576c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Pridobivanje temperaturnih podatkov z Map", "Section",ExpressionUUID->"04da4af4-1753-574c-9244-145091f36019"],

Cell["\<\
Funkcijo getTemperatureData uporabimo nad vsemi lokacijami z Map. Rezultat je \
Association, kjer je za vsako mesto shranjena \[CHacek]asovna vrsta mese\
\[CHacek]nih temperatur.\
\>", "Text",ExpressionUUID->"cd005249-c1c0-514a-8b92-7d8d9ef698b6"],

Cell[CellGroupData[{

Cell["\<\
temperatureMonthly = AssociationThread[
  Keys[locations],
  Map[getTemperatureData, Values[locations]]
];

(* Shranimo kopijo obdelanih podatkov v prenosljivi relativni poti. *)
Export[
  FileNameJoin[{dataDir, \"temperature_monthly.wl\"}],
  temperatureMonthly
];

Map[Length, temperatureMonthly]\
\>", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"565fed22-333e-614f-9e81-eecccaffc9be"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Ljubljana\"\>", "\[Rule]", "420"}], ",", 
   RowBox[{"\<\"London\"\>", "\[Rule]", "420"}], ",", 
   RowBox[{"\<\"New York\"\>", "\[Rule]", "420"}], ",", 
   RowBox[{"\<\"Tokyo\"\>", "\[Rule]", "420"}], ",", 
   RowBox[{"\<\"Sydney\"\>", "\[Rule]", "420"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.997002090792053*^9, 3.9970022985213623`*^9, 
  3.997002434014427*^9, 3.997002471246868*^9, 3.997002557440157*^9, 
  3.9970027057692127`*^9, 3.9970036411939583`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"230e64cb-648d-854a-ad70-b328bca5c675"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Osnovni prikaz podatkov", "Section",ExpressionUUID->"715a0153-b621-cd4e-80e9-533be63221ad"],

Cell["\<\
Najprej prika\[ZHacek]emo mese\[CHacek]ne temperature za Ljubljano. Ker so \
mese\[CHacek]na nihanja velika, je naslednji korak izra\[CHacek]un letnih \
povpre\[CHacek]ij.\
\>", "Text",ExpressionUUID->"bcb6add8-4c60-9d4f-9100-64e028ec71b5"],

