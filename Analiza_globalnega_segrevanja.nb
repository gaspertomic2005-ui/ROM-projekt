Cell[CellGroupData[{

Cell["12. Izvoz rezultatov", "Section",ExpressionUUID->"681044f3-b1dc-5d47-b9b0-e2f95ac6fbe4"],

Cell["\<\
Klju\[CHacek]ne rezultate izvozimo v mapo data. Ker uporabljamo \
NotebookDirectory in FileNameJoin, se poti samodejno prilagodijo \
ra\[CHacek]unalniku, na katerem je projekt odprt.\
\>", "Text",ExpressionUUID->"36050a7a-2a37-3343-82bb-8c88dfce0f1e"],

Cell[CellGroupData[{

Cell["\<\
Export[
  FileNameJoin[{dataDir, \"trend_summary.csv\"}],
  Normal[summaryDataset]
];

Export[
  FileNameJoin[{dataDir, \"annual_temperature_ljubljana.csv\"}],
  Prepend[ljData, {\"Year\", \"MeanTemperatureC\"}]
];

Export[
  FileNameJoin[{dataDir, \"annual_precipitation_ljubljana.csv\"}],
  Prepend[precipitationAnnualLjubljana, {\"Year\", \"TotalPrecipitationMM\"}]
];

FileNames[\"*\", dataDir]\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"cd8b0c2c-7b54-dd4f-aaf8-4bd9920d9972"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"D:\\\\Faks\\\\ROM\\\\ROM_globalno_segrevanje_projekt\\\\ROM_\
