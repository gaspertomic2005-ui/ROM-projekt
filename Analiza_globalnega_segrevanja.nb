Cell[CellGroupData[{

Cell["10. Podroben trend za Ljubljano", "Section",ExpressionUUID->"d28af32d-4ca6-7b4e-8311-1a33f1ac85e6"],

Cell["\<\
Spodnji graf zdru\[ZHacek]i dejanska letna povpre\[CHacek]ja in linearni \
model za Ljubljano.\
\>", "Text",ExpressionUUID->"af4effe6-440e-1e4d-ae8c-bcc2b48dfa7b"],

Cell[CellGroupData[{

Cell["\<\
ljData = annualByCity[\"Ljubljana\"];
ljModel = LinearModelFit[ljData, {1, x}, x];

Show[
  ListPlot[
    ljData,
    Frame -> True,
    FrameLabel -> {\"Leto\", \"Letna povpre\[CHacek]na temperatura \
[\[Degree]C]\"},
    PlotLabel -> \"Ljubljana: letne temperature in linearni trend\",
    PlotMarkers -> Automatic
  ],
  Plot[
    ljModel[x],
    {x, Min[ljData[[All, 1]]], Max[ljData[[All, 1]]]}
  ],
  ImageSize -> Large
]\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"98cbe33b-828e-5343-9f72-d32b3cdcac81"],

