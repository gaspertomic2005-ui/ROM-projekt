Cell[CellGroupData[{

Cell["7. Temperaturne anomalije glede na obdobje 1991\[Dash]2020", "Section",ExpressionUUID->"a5166a5a-a330-de48-8c0b-43bff2de78a9"],

Cell["\<\
Temperaturna anomalija pove, za koliko je bilo posamezno leto \
toplej\[SHacek]e ali hladnej\[SHacek]e od referen\[CHacek]nega \
povpre\[CHacek]ja. Kot osnovno obdobje uporabimo 1991\[Dash]2020. Pozitivna \
anomalija pomeni leto nad referen\[CHacek]nim povpre\[CHacek]jem.\
\>", "Text",ExpressionUUID->"ebe036d7-7d32-8d4d-a213-29154b979d1a"],

Cell[CellGroupData[{

Cell["\<\
ClearAll[temperatureAnomalies];

temperatureAnomalies[data_] := Module[{baselineValues, baselineMean},
  baselineValues = Cases[
    data,
    {y_, t_} /; 1991 <= y <= 2020 :> t
  ];
  baselineMean = Mean[baselineValues];
  ({#[[1]], #[[2]] - baselineMean} &) /@ data
];

anomaliesByCity = Map[temperatureAnomalies, annualByCity];

ListLinePlot[
  Values[anomaliesByCity],
  PlotLegends -> Placed[Keys[anomaliesByCity], Right],
  Frame -> True,
  FrameLabel -> {\"Leto\", \"Temperaturna anomalija [\[Degree]C]\"},
  PlotLabel -> \"Temperaturne anomalije glede na povpre\[CHacek]je \
1991\[Dash]2020\",
  PlotRange -> All,
  ImageSize -> Large
]\
\>", "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"ee99fa3f-a714-2c4e-9f2a-4e140bb5229c"],

