Cell[CellGroupData[{

Cell["2. Izbrane lokacije in \[CHacek]asovno obdobje", "Section",ExpressionUUID->"4dc7860a-317c-6b42-bc9e-a475ba019b54"],

Cell["\<\
Izbranih je pet mest z razli\[CHacek]nih delov sveta. Lokacije podamo s \
koordinatami, kar je za WeatherData prenosljivo in neodvisno od lokalnih \
nastavitev. Analiziramo obdobje 1990\[Dash]2024.\
\>", "Text",ExpressionUUID->"34e4402d-2841-ed4e-82df-c600bdc2b53a"],

Cell[CellGroupData[{

Cell["\<\
locations = <|
   \"Ljubljana\" -> {46.0569, 14.5058},
   \"London\" -> {51.5074, -0.1278},
   \"New York\" -> {40.7128, -74.0060},
   \"Tokyo\" -> {35.6762, 139.6503},
   \"Sydney\" -> {-33.8688, 151.2093}
|>;

startDate = {1990, 1, 1};
endDate = {2024, 12, 31};

Dataset[
  KeyValueMap[
    <|\"Mesto\" -> #1, \"Koordinate\" -> #2|> &,
    locations
  ]
]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"9efa7725-9688-2744-91e4-2bae7e11f9a9"],

