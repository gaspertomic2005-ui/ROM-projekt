Cell["11. Dodatna analiza padavin", "Section",ExpressionUUID->"ff8cf336-89dc-7f41-bb70-f3b53708773b"],

Cell["\<\
Poleg temperature analiziramo tudi letne vsote padavin za Ljubljano v obdobju \
2000\[Dash]2024. S tem poka\[ZHacek]emo uporabo druge lastnosti WeatherData \
in dodamo \[SHacek]e en neodvisen vremenski kazalnik.\
\>", "Text",ExpressionUUID->"037f8199-bfd9-f044-91ea-44fa528b4d51"],

Cell[CellGroupData[{

Cell["\<\
precipitationMonthlyLjubljana = getPrecipitationData[
  locations[\"Ljubljana\"],
  {2000, 1, 1},
  {2024, 12, 31}
];

precipitationAnnualLjubljana = annualSum[precipitationMonthlyLjubljana];

ListLinePlot[
  precipitationAnnualLjubljana,
  Frame -> True,
  FrameLabel -> {\"Leto\", \"Letna koli\[CHacek]ina padavin [mm]\"},
  PlotLabel -> \"Letna koli\[CHacek]ina padavin \[Dash] Ljubljana\",
  PlotRange -> All,
  ImageSize -> Large
]\
\>", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"299bf3e4-e37e-5f4a-ae4c-dbc11024e614"],

