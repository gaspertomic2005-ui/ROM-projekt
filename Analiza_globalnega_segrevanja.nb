Cell[CellGroupData[{

Cell["6. Letna povpre\[CHacek]ja in primerjava mest", "Section",ExpressionUUID->"a43d0927-746b-c746-b3ea-0181ede208b6"],

Cell["\<\
Mese\[CHacek]ne podatke pretvorimo v letna povpre\[CHacek]ja. S tem zmanj\
\[SHacek]amo sezonsko nihanje in la\[ZHacek]je opazimo dolgoro\[CHacek]ni \
trend.\
\>", "Text",ExpressionUUID->"109037e8-50e6-ec4c-8f2b-b5cb1d83ecf8"],

Cell[CellGroupData[{

Cell["\<\
annualByCity = Map[annualMean, temperatureMonthly];

ListLinePlot[
  Values[annualByCity],
  PlotLegends -> Placed[Keys[annualByCity], Right],
  Frame -> True,
  FrameLabel -> {\"Leto\", \"Letna povpre\[CHacek]na temperatura [\[Degree]C]\
\"},
  PlotLabel -> \"Letne povpre\[CHacek]ne temperature izbranih mest\",
  PlotRange -> All,
  ImageSize -> Large
]\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"fb6bb211-c7ee-1945-9bac-24c2293ae763"],

